                <button
                    t-attf-class="btn #{props.classList ? props.classList : 'btn-primary'} o_get_location"
                    t-on-click="_onClickGetLocation"
                    t-att-disabled="props.readonly">
                <i class="fa fa-map-marker"/> <t t-esc="props.string"/>
            </button>
        </div>
