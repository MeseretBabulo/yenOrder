<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="TimesheetCheckInOutButtons">
    <t t-if="task_id">
        <button 
            type="button"
            class="btn btn-success"
            t-on-click="() => checkInOut('in')">
            Check-In
        </button>
        <button 
            type="button"
            class="btn btn-danger"
            t-on-click="() => checkInOut('out')">
            Check-Out
        </button>
    </t>
</t>

    <t t-name="bista_timesheet_attendance.LocationLatLngCA" >
