          <record id="view_task_form2_inherited_inherits_add_buttons" model="ir.ui.view">
    <field name="name">view.task.form2.inherited.inherits.add.button</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited" />
    <field name="arch" type="xml">
        <xpath expr="//notebook/page[@id='timesheets_tab']" position="after">
            <page name="attendance_tab" string="Attendance">
                <field name="attendance_state" invisible="1" />
                <field name="latitude_in" invisible="1" force_save="1" />
                <field name="longitude_in" invisible="1" force_save="1" />
                <field name="latitude_out" invisible="1" force_save="1" />
                <field name="longitude_out" invisible="1" force_save="1" />
                
                <group name="sign_in_out">
                    <widget 
                        name="location_lat_lng"
                        string="Check-In"
                        lat="latitude_in"
                        lng="longitude_in"
                        show_map="true"
                        map_height="400"
                        map_width="500px"
                        classList="btn-success d-block"
                        button_attrs='{"name": "timesheet_sign_in", "type": "object", "context": {"type": "in"}}' />
                    
                    <widget 
                        name="location_lat_lng"
                        string="Check-Out"
                        lat="latitude_out"
                        lng="longitude_out"
                        show_map="true"
                        map_height="400"
                        map_width="500px"
                        classList="btn-danger d-block"
                        button_attrs='{"name": "timesheet_sign_out", "type": "object", "context": {"type": "out"}}' />
                </group>

                <field name="attendance_line_ids"
                    nolabel="1"
                    options="{'no_create': True, 'no_open': True}">
                    <tree create="0" delete="0" editable="top">
                        <field name="date" readonly="1" force_save="1" optional="show" />
                        <field name="company_id" invisible="1" />
                        <field name="task_id" invisible="1" />
                        <field name="description" optional="show" />
                        <field name="check_in_time" readonly="1" optional="show" force_save="1" />
                        <field name="check_in_latitude" readonly="1" optional="show" force_save="1" />
                        <field name="check_in_longitude" readonly="1" optional="show" force_save="1" />
                        <field name="check_out_time" readonly="1" optional="show" force_save="1" />
                        <field name="check_out_latitude" readonly="1" optional="show" force_save="1" />
                        <field name="check_out_longitude" readonly="1" optional="show" force_save="1" />
                        <field name="delay_time_differance" widget="float_time" optional="hide" />
                        <field name="temperature" optional="hide" />
                        <field name="delay_reason" optional="hide" />
                        <field invisible="1" name="employee_id" />
                    </tree>
                </field>
            </page>
        </xpath>
    </field>
</record>


</odoo>
