<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_contact_info_tree" model="ir.ui.view">
        <field name="name">contact.info.tree</field>
        <field name="model">contact.info</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_contact_info_form" model="ir.ui.view">
        <field name="name">contact.info.form</field>
        <field name="model">contact.info</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="message"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contact_info" model="ir.actions.act_window">
        <field name="name">Contact Info</field>
        <field name="res_model">contact.info</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for OdooBot Messages -->
    <record id="action_odoobot_messages" model="ir.actions.act_window">
        <field name="name">OdooBot Messages</field>
        <field name="res_model">mail.mail</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('author_id.name', '=', 'OdooBot')]</field>
        <field name="context">{'search_default_message_type': 'email'}</field>
    </record>
</odoo> 