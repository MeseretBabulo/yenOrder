<odoo>

    <record id="view_sales_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.variant</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="hs_code" />
            </xpath>
            <xpath expr="//tree/field[@name='product_uom_qty']" position="before">
                <field name="gross_quantity" string="Gross Quantity" readonly="0" />
            </xpath>
            <xpath expr="//tree/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Net Quantity</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="port_of_loading" string="Port Of Loading" readonly="0" />
            </xpath>
            <xpath expr="//field[@name='port_of_loading']" position="after">
                <field name="port_of_discharge" string="Port Of Discharge" readonly="0" />
            </xpath>
            <xpath expr="//field[@name='port_of_discharge']" position="after">
                <field name="ico" string="ICO" readonly="0" />
            </xpath>
            <xpath expr="//field[@name='ico']" position="after">
                <field name="cert_no" string="Cert No" readonly="0" />
            </xpath>
            <xpath expr="//tree/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Net Quantity</attribute>
            </xpath>
        </field>
    </record>


</odoo>