<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="email_template_verification_request" model="mail.template">
            <field name="name">Verification Request</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="subject">Verification Request: {{object.name}}</field>
<!--            <field name="email_from">{{object.project_id.user_id.email}}</field>-->
            <field name="email_to">{{object.project_id.user_id.email}}</field>
            <field name="body_html" type="html">
                <div>
                    Dear <t t-out="object.project_id.user_id.name"/><br/>
                    <br/>
                    The <t t-out="object.name"/> has been generated for an approval
                    <p>Please review the appointment details and approve it.</p>
                    <p>Thank you.</p>
                    <a t-attf-href="/web#id={{object.id}}&amp;view_type=form&amp;model=project.task"
                       style="color: #875A7B;">
                        Click To Verify Appointment
                    </a>
                </div>

            </field>
        </record>
    </data>
</odoo>
