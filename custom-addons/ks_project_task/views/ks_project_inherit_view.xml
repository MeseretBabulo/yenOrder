        <record id="survey_user_input_linee_action" model="ir.actions.act_window">
            <field name="name">Answers</field>
            <field name="res_model">survey.user_input.line</field>
            <field name="view_mode">tree,form</field>
            <!--            <field name="search_view_id" ref="survey_user_input_line_view_search"/>-->
            <!--            <field name="context">{'search_default_group_by_survey': True, 'search_default_group_by_user_input': True}-->
            <!--            </field>-->
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    All surveys
                </p>
            </field>
        </record>

        <record id="action_create_survey_in_project" model="ir.actions.server">
            <field name="name">Create Survey</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="binding_model_id" ref="project.model_project_project"/>
            <field name="state">code</field>
            <field name="code">
                action = records._open_wizard_from_here()
            </field>
        </record>

        <menuitem name="Answers"
                  id="menu_survey_response_line_form_inherit"
                  action="survey_user_input_linee_action"
                  parent="survey.menu_survey_type_form1"
                  sequence="5"/>

        <menuitem name="Link Survey"
                  id="Link_project_survey_menu_item"
                  action="link_project_survey_action"
                  parent="project.menu_project_report"
                  sequence="6"/>

        <!--        <record model="ir.ui.menu" id="via_sales_enhancement.menu_via_service_note_survey">-->
        <!--      <field name="name">Service Note</field>-->
        <!--    </record>-->

        <record model="ir.ui.menu" id="via_sales_enhancement.menu_via_service_note">
            <field name="name">Service Note Data</field>
        </record>

        <menuitem id="via_sales_enhancement.menu_via_service_note_survey" active="False"/>

        <record model="ir.actions.act_window" id="service_note_survey_action">
            <field name="name">Service Note</field>
            <field name="res_model">survey.user_input</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="survey.survey_user_input_view_tree"/>
            <field name="search_view_id" ref="survey.survey_user_input_view_search"/>
            <field name="context">{'search_default_group_by_survey': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    Nobody has replied to your surveys yet
                </p>
            </field>
        </record>

        <!--Instead of popup , redirect to form view (calender view) -->
        <record id="project_project_calendar_view_inherit" model="ir.ui.view">
            <field name="name">project.project.calendar.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_calendar"/>
            <field name="arch" type="xml">
                <xpath expr="//calendar" position="attributes">
                    <attribute name="event_open_popup">False</attribute>
                </xpath>
            </field>
        </record>

        <menuitem name="Service Note"
                  id="Service_note_survey_menu_item"
                  action="service_note_survey_action"
                  parent="project.menu_project_config"
                  sequence="6"/>

