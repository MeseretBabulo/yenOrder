<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

                <record id="project_form_inherit" model="ir.ui.view">
                    <field name="name">Project.form</field>
                    <field name="model">project.project</field>
                    <field name="inherit_id" ref="project.edit_project"/>
                    <field name="priority" eval="8"/>
                    <field name="arch" type="xml">
                        <xpath expr="//field[@name='tag_ids']" position="after">
        <!--                    <field name="ks_survey_read_only"/>-->
                            <field name="ks_survey"/>
                        </xpath>
                        <xpath expr="//field[@name='partner_id']" position="attributes">
                            <attribute name="required">1</attribute>
                        </xpath>
                        <div name="button_box" position="inside">
                            <button name="action_survey_user_input_completed"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o">
                                <field string="Service Note" name="ks_answer_done_count" widget="statinfo"/>
                            </button>
                        </div>
                    </field>
                </record>
