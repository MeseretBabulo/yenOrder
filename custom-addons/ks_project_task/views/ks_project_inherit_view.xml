        <!--        Inherit attendance_line_ids records tree view-->
        <record id="view_task_timesheet_add_custom_field_inherit" model="ir.ui.view">
            <field name="name">view.task.form2.inherited.inherits.add.fields.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="bista_timesheet_attendance.view_task_form2_inherited_inherits_add_buttons"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='attendance_tab']//field[@name='attendance_line_ids']/tree" position="inside">
                    <field name="visit_id" optional="show"/>
                    <button name="create_attendance_update_with_id"
                            string="Change Attendance"
                            type="object"
                            class="btn-primary"
                    />
                </xpath>
            </field>
        </record>
        <record id="project_form_inherit_medical" model="ir.ui.view">
            <field name="name">Project.form</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='settings']//field[@name='privacy_visibility']" position="after">
                    <field name="medical_appointment_checker"/>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_menu_programs">
            <field name="name">Show filter programs by team</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="view_id" ref="project.view_project_kanban"/>
            <field name="search_view_id" ref="project.view_project_project_filter"/>
            <field name="domain">[
                ('team_id.member_ids', '=', uid)
                ]
            </field>
        </record>

        <menuitem name="Programs" id="ks_project_task.menu_task_programs"
                  parent="project.menu_main_pm" action="ks_project_task.action_menu_programs" sequence="1"/>
    </data>
</odoo>
