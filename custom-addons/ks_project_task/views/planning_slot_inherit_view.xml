<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="planning_slot_calendar_inherit" model="ir.ui.view">
            <field name="name">planning_slot.calendar.inherit</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_calendar"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="role_id" position="after">
                    <field name="person_supported"/>
                    <field name="contact_ids" invisible="1"/>
                    <field name="contact_id" domain="[('id', 'in', contact_ids)]"/>
                </field>
                <field name="role_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="role_id" position="replace">
                    <field name="role_id" string="Support Team"/>
                </field>
                <field name="resource_id" position="attributes">
                    <attribute name="string">Support Partner</attribute>
                </field>
            </field>
        </record>
        <record id="my_planning_slot_calendar_inherit" model="ir.ui.view">
            <field name="name">My.planning_slot.calendar.inherit</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_my_calendar"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="role_id" position="after">
                    <field name="person_supported"/>
                    <field name="contact_ids" invisible="1"/>
                    <field name="contact_id" domain="[('id', 'in', contact_ids)]"/>
                    <!-- <field name="project_id" string="ISP Program"/> -->
                    <!-- <field name="task_id"/> -->
                    <field name="navigate_to_lag_lat" widget="url"/>
                </field>
                <field name="role_id" position="attributes">
                    <attribute name="string">Support Team</attribute>
                </field>
                <field name="resource_id" position="attributes">
                    <attribute name="string">Support Partner</attribute>
                </field>
            </field>
        </record>
        <record id="planning_slot_calendar_inherit_form" model="ir.ui.view">
            <field name="name">planning_slot.calendar.inherit.form</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="role_id" position="after">
                    <field name="person_supported"/>
                    <field name="contact_ids" invisible="1"/>
                    <field name="contact_id" domain="[('id', 'in', contact_ids)]"/>
                    <field name="available_resource_ids" widget="many2many_tags" invisible="1"/>
                </field>
                <field name="role_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="role_id" position="attributes">
                    <attribute name="string">Support Team</attribute>
                </field>
                <field name="resource_id" position="attributes">
                    <attribute name="string">Support Partner</attribute>
                </field>

                <xpath expr="//sheet/group/group/field[@name='resource_id']" position="attributes">
                    <attribute name="domain">[('id', 'in', available_resource_ids)]</attribute>
                </xpath>
            </field>
        </record>
