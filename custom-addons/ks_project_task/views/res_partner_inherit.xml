<?xml version="1.0" encoding="utf-8"?>
<odoo>

   
   <record id="res_partner_view_project_task_inherit" model="ir.ui.view">
    <field name="name">res.partner.project.task.inherit</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="priority" eval="9"/>
    <field name="arch" type="xml">
        <div name="button_box" position="inside">
            <button class="oe_stat_button" name="action_open_projects_view" type="object"
                    icon="fa-credit-card">
                <field string="Project" name="project_count" widget="statinfo"/>
            </button>
            <button name="survey_user_answers"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o">
                <field string="Service Note" name="ks_answer_count" widget="statinfo"/>
            </button>
        </div>
        <xpath expr="//form/sheet" position="before">
            <header>
                <button name="action_archive" type="object" class="oe_highlight" string="Archive"
                        invisible="active == False"/>
                <button name="action_unarchive" type="object" class="oe_highlight" string="Unarchive"
                        invisible="active == True"/>
                <button name="create_medical_appointment" type="object" class="oe_highlight" string="Create Medical Appointment"/>
            </header>
        </xpath>
        <xpath expr="//page[@name='contact_addresses']/field[@name='child_ids']" position="replace">
            <field name="child_ids" mode="kanban"
                   context="{
                       'default_parent_id': active_id,
                       'default_street': street,
                       'default_street2': street2,
                       'default_city': city,
                       'default_state_id': state_id,
                       'default_zip': zip,
                       'default_country_id': country_id,
                       'default_lang': lang,
                       'default_user_id': user_id,
                       'default_type': 'other'
                   }">
                <kanban>
                    <field name="id"/>
                    <field name="color"/>
                    <field name="name"/>
                    <field name="title"/>
                    <field name="type"/>
                    <field name="email"/>
                    <field name="parent_id"/>
                    <field name="is_company"/>
                    <field name="function"/>
                    <field name="phone"/>
                    <field name="street"/>
                    <field name="street2"/>
                    <field name="zip"/>
                    <field name="city"/>
                    <field name="country_id"/>
                    <field name="mobile"/>
                    <field name="state_id"/>
                    <field name="image_128"/>
                    <field name="avatar_128"/>
                    <field name="lang"/>
                    <field name="comment"/>
                    <field name="display_name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <t t-set="color" t-value="kanban_color(record.color.raw_value)"/>
                            <div t-att-class="color + (record.title.raw_value == 1 ? ' oe_kanban_color_alert' : '') + ' oe_kanban_global_click'">
                                <div class="o_kanban_image">
                                    <img alt="Contact image" t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <field name="name"/>
                                    <div t-if="record.function.raw_value"><field name="function"/></div>
                                    <div t-if="record.email.raw_value"><field name="email" widget="email"/></div>
                                    <div t-if="record.type.raw_value != 'contact'">
                                        <div>
                                            <field name="zip"/>
                                            <field name="city"/>
                                        </div>
                                        <field t-if="record.state_id.raw_value" name="state_id"/>
                                        <field name="country_id"/>
                                    </div>
                                    <div t-if="record.phone.raw_value">Phone: <t t-esc="record.phone.value"/></div>
                                    <div t-if="record.mobile.raw_value">Mobile: <t t-esc="record.mobile.value"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
                <form string="Contact / Address">
                    <sheet>
                        <field name="type" required="1" widget="radio" options="{'horizontal': true}"/>
                        <field name="parent_id" invisible="True"/>
                        <hr/>
                        <group>
                            <group>
                                <field name="name" string="Contact Name" required="type == 'contact'"/>
                                <field name="title" options="{'no_open': True}" placeholder="e.g. Mr."
                                       invisible="type != 'contact'"/>
                                <field name="function" placeholder="e.g. Sales Director"
                                       invisible="type != 'contact'"/>
                                <label for="street" string="Address" invisible="type == 'contact'"/>
                                <div invisible="type == 'contact'">
                                    <div class="o_address_format" name="div_address">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                    </div>
                                </div>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="mobile" widget="phone"/>
                                <field name="company_id" invisible="True"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="comment" placeholder="Internal notes..."/>
                            </group>
                            <group>
                                <strong>Geo Location</strong><br/><br/>
                                <span>Lat :</span>
                                <field name="partner_latitude" nolabel="1" readonly="1"/>
                                <span>, Long:</span>
                                <field name="partner_longitude" nolabel="1" readonly="1"/>
                                <br/><br/>
                                <span invisible="date_localization == False">Updated on:</span>
                                <field name="date_localization" nolabel="1" readonly="1"/>
                                <br/>
                                <span class="oe_inline">
                                    <button string="(refresh)" name="geo_localize" class="btn btn-link" type="object"/>
                                </span>
                            </group>
                        </group>
                        <field name="lang" invisible="True"/>
                        <field name="user_id" invisible="True"/>
                    </sheet>
                </form>
            </field>
        </xpath>
    </field>
</record>

    <record id="res_partner_view_team_inherit" model="ir.ui.view">
        <field name="name">res.partner.view.team.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sales_team.res_partner_view_team"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="before">
                <field name="sales_team_ids" widget="many2many_tags" />
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_res_partner_form_inherit_add_page_survey" model="ir.ui.view">
        <field name="name">view.res.partner.form.inherit.add.page.survey</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="survey" string="Survey Details">
                    <group>
<!--                    <field name="survey_id"/>-->
                    <field name="survey_ids">
                        <tree>
                            <field name="title"/>
                            <field name="project_manager"/>
                            <button name="open_survey_url"
                                string="Open Survey"
                                type="object"
                                class="btn-primary"
                                />
                            <button name="open_answers"
                                string="Answers"
                                type="object"
                                class="btn-primary"
                                />
                            <button name="action_edit"
                                string="Edit"
                                type="object"
                                class="btn-primary"
                                />
                        </tree>
                            </field>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='phone']" position="after">
                <field name="linked_medical_project_id" invisible="1"/>
            </xpath>
            <div name="button_box" position="inside">
                    <button class="oe_stat_button" type="object" name="medical_appointments_tasks"
                        icon="fa-stethoscope">
                        <field string="Medical Appointments" name="medical_appointments_tasks_count" widget="statinfo"/>
                    </button>
                </div>
        </field>
    </record>
</odoo>
