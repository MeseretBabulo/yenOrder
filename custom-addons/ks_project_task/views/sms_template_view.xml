<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sms_template_form_view" model="ir.ui.view">
            <field name="name">sms_template.form</field>
            <field name="model">sms.template.custom</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="context"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="sms_template_tree_view" model="ir.ui.view">
            <field name="name">sms_template.tree</field>
            <field name="model">sms.template.custom</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="context"/>
                </tree>
            </field>
        </record>

        <record id="sms_template_act_window" model="ir.actions.act_window">
            <field name="name">SMS Template</field>
            <field name="res_model">sms.template.custom</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>