<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_archive_wizard_form" model="ir.ui.view">
        <field name="name">res.partner.archive.wizard.form</field>
        <field name="model">res.partner.archive.wizard</field>
        <field name="arch" type="xml">
            <form  string="Archive Partner">
                <group>
                    <field name="reason_of_leaving"/>
                    <field name="logged_in_user"/>
                    <field name="date"/>
                    <field name="partner_id" invisible="1"/>
                </group>

                <footer>
                    <button string="Archive" name="action_archive" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
