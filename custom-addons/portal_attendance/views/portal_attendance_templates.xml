<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide Invoice and Order menu items for employees -->
    <template id="portal_my_home_menu" name="Portal Menu" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-set="hide_for_employee" t-value="is_employee"/>
            <style>
                .hide-for-employee {
                    display: none !important;
                }
            </style>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    if (<t t-out="hide_for_employee"/>) {
                        document.querySelectorAll('#portal_client_category').forEach(function(el) {
                            el.classList.add('hide-for-employee');
                        });
                    }
                });
                document.querySelector('#portal_client_category').classList.add('hide-for-employee');
            </script>
        </xpath>
    </template>

    <!-- Portal My Home Menu -->
    <template id="portal_my_home_attendance" name="Portal My Home Attendance" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="is_employee">
                <div class="col-12 col-md-6">
                    <div class="card attendance-card">
                        <!-- Loading Overlay -->
                        <div id="loading-overlay" class="loading-overlay d-none">
                            <div class="loading-content">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <div class="loading-text mt-2">Processing...</div>
                            </div>
                        </div>
                        
                        <div class="card-body text-center">
                            <!-- Add Time Display -->
                            <div class="current-time mb-4">
                                <h3 id="current-time" class="text-primary">00:00:00</h3>
                                <p id="current-date" class="text-muted"></p>
                            </div>
                            
                            <!-- Add Work Duration for checked-in status -->
                            <div t-if="check_in_status" class="work-duration mb-4">
                                <h4>Current Session</h4>
                                <div id="work-timer" class="h5 text-success">00:00:00</div>
                            </div>
                            
                            <!-- Attendance Buttons -->
                            <div class="attendance-buttons mt-4">
                                <button t-if="not check_in_status"
                                        class="btn btn-primary btn-lg check-in-btn w-100 mb-3"
                                        onclick="handleAttendanceWithLocation('check_in', this)">
                                    <i class="fa fa-sign-in me-2"></i>
                                    <span class="button-text">Check In</span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                </button>
                                <button t-if="check_in_status"
                                        class="btn btn-danger btn-lg check-out-btn w-100 mb-3"
                                        onclick="handleAttendanceWithLocation('check_out', this)">
                                    <i class="fa fa-sign-out me-2"></i>
                                    <span class="button-text">Check Out</span>
                                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                </button>
                            </div>
                            
                            <!-- Enhanced Attendance Status -->
                            <div class="attendance-status mt-4">
                                <t t-if="check_in_status">
                                    <div class="alert alert-success">
                                        <i class="fa fa-clock-o me-2"></i>
                                        <strong>Currently Checked In</strong>
                                        <p class="mb-0">Since: <span id="check-in-time"><t t-esc="last_attendance.check_in.strftime('%H:%M:%S')"/></span></p>                                    
                                        <p class="mb-0" id="location-name">Location: Loading...</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Add JavaScript for real-time updates -->
                <script>
                    // Update current time
                    function updateTime() {
                        const now = new Date();
                        document.getElementById('current-time').textContent = now.toLocaleTimeString();
                        document.getElementById('current-date').textContent = now.toLocaleDateString(undefined, { 
                            weekday: 'long', 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        });
                    }
                    
                    // Update work duration timer
                    let sessionSeconds = 0;
                    let timerInterval;

                    function initializeSessionTimer() {
                        const checkInTime = new Date("<t t-esc="last_attendance.check_in"/>");
                        const now = new Date();
                        sessionSeconds = Math.floor((now - checkInTime) / 1000);
                    }

                    function updateWorkDuration() {
                        const hours = String(Math.floor(sessionSeconds / 3600)).padStart(2, '0');
                        const minutes = Math.floor((sessionSeconds % 3600) / 60);
                        const seconds = sessionSeconds % 60;
                        
                        const workTimer = document.getElementById('work-timer');
                        if (workTimer) {
                            workTimer.textContent = 
                                `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
                        }
                        sessionSeconds++;
                    }

                    // Function to start timer from 00:00:00
                    function startNewTimer() {
                        sessionSeconds = 0;   
                        if (timerInterval) {
                            clearInterval(timerInterval);
                        }
                        timerInterval = setInterval(updateWorkDuration, 1000);
                    }

                    // Initialize timers
                    setInterval(updateTime, 1000);
                    if (document.getElementById('work-timer')) {
                        if ("<t t-esc="check_in_status"/>") {
                            initializeSessionTimer();
                            timerInterval = setInterval(updateWorkDuration, 1000);
                        }
                    }
                    
                    // Update location name
                    if ("geolocation" in navigator) {
                        navigator.geolocation.getCurrentPosition(async function(position) {
                            try {
                                const response = await fetch(
                                    `https://nominatim.openstreetmap.org/reverse?lat=${position.coords.latitude}&amp;lon=${position.coords.longitude}&amp;format=json`
                                );
                                const data = await response.json();
                                // Extract only the street name from the address
                                const streetName = data.address.road || data.address.street || 'Unknown street';
                                const locationElement = document.getElementById('location-name');
                                if (locationElement) {
                                    locationElement.textContent = `Location: ${streetName}`;
                                }
                            } catch (error) {
                                console.error('Error fetching location name:', error);
                                const locationElement = document.getElementById('location-name');
                                if (locationElement) {
                                    locationElement.textContent = 'Location: Unable to determine street';
                                }
                            }
                        });
                    }

                    // Modify the existing handleAttendance function
                    async function handleAttendanceWithLocation(action, button) {
                        // ... existing attendance handling code ...
                        if (action === 'check_in') {
                            startNewTimer();
                        } else if (action === 'check_out') {
                            if (timerInterval) {
                                clearInterval(timerInterval);
                            }
                        }
                    }
                </script>
            </t>
        </xpath>
    </template>

    <!-- Main attendance page template -->
    <template id="portal_attendance_page" name="Portal Attendance">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <t t-if="is_employee or is_admin">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-6">
                            <div class="card attendance-card shadow">
                                <!-- Loading Overlay -->
                                <div id="loading-overlay" class="loading-overlay d-none">
                                    <div class="loading-content">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <div class="loading-text mt-2">Processing...</div>
                                    </div>
                                </div>
                                
                                <div class="card-body text-center p-5">
                                    <h3 class="mb-4">Attendance Portal</h3>
                                    
                                    <!-- Connection Status -->
                                    <div class="connection-status mb-4">
                                        <div class="d-flex justify-content-center align-items-center mb-2">
                                            <i class="fa fa-wifi text-success me-2"></i>
                                            <span>Connected</span>
                                        </div>
                                        <div class="d-flex justify-content-center align-items-center mb-2">
                                            <i class="fa fa-map-marker text-primary me-2"></i>
                                            <span id="location-status">Waiting for location...</span>
                                        </div>
                                        <div class="d-flex justify-content-center align-items-center">
                                            <i class="fa fa-shield text-success me-2"></i>
                                            <span>Secure Connection</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Attendance Buttons -->
                                    <div class="attendance-buttons mt-4">
                                        <button t-if="not check_in_status"
                                                class="btn btn-primary btn-lg check-in-btn w-100 mb-3"
                                                onclick="handleAttendance('check_in', this)">
                                            <i class="fa fa-sign-in me-2"></i>
                                            <span class="button-text">Check In</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                        </button>
                                        <button t-if="check_in_status"
                                                class="btn btn-danger btn-lg check-out-btn w-100 mb-3"
                                                onclick="handleAttendance('check_out', this)">
                                            <i class="fa fa-sign-out me-2"></i>
                                            <span class="button-text">Check Out</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                                        </button>
                                    </div>
                                    
                                    <!-- Attendance Status -->
                                    <div class="attendance-status mt-4">
                                        <t t-if="last_attendance">
                                            <div class="card">
                                                <div class="card-body">
                                                    <h5 class="card-title mb-4"><t t-esc="employee.name"/></h5>
                                                    
                                                    <!-- Check-in Information -->
                                                    <div class="mb-3">
                                                        <strong>Check In:</strong> <t t-esc="last_attendance.check_in.strftime('%m/%d/%Y %H:%M:%S')"/>
                                                    </div>
                                                    
                                                    <!-- Check-out Information -->
                                                    <div class="mb-3">
                                                        <strong>Check Out:</strong> 
                                                        <t t-if="last_attendance.check_out">
                                                            <t t-esc="last_attendance.check_out.strftime('%m/%d/%Y %H:%M:%S')"/>
                                                        </t>
                                                        <t t-else="">
                                                            Not checked out
                                                        </t>
                                                    </div>
                                                    
                                                    <!-- Location Information -->
                                                    <div class="mb-3">
                                                        <strong>Location Data</strong>
                                                        <div class="ms-3">
                                                            <p class="mb-1">Location Name: <t t-esc="last_attendance.location_name or 'Unknown'"/></p>
                                                            <p class="mb-1">GPS Coordinates: 
                                                                <t t-esc="'%.7f' % (last_attendance.latitude or 0.0)"/>,
                                                                <t t-esc="'%.7f' % (last_attendance.longitude or 0.0)"/>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- Device and Network Information -->
                                                    <div class="mb-3">
                                                        <strong>Device Information</strong>
                                                        <div class="ms-3">
                                                            <p class="mb-1">Browser: <t t-esc="last_attendance.browser_info or 'Unknown'"/></p>
                                                            <p class="mb-1">IP Address: <t t-esc="last_attendance.ip_address or 'Unknown'"/></p>
                                                            <p class="mb-1">Device Details: <t t-esc="last_attendance.device_info or 'Unknown'"/></p>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- Hours Information -->
                                                    <div class="mb-3">
                                                        <strong>Hours Information</strong>
                                                        <div class="ms-3">
                                                            <p class="mb-1">Worked Hours: <t t-esc="'%02d:%02d' % (int(last_attendance.worked_hours or 0), int((last_attendance.worked_hours or 0) % 1 * 60))"/></p>
                                                            <p class="mb-1">Extra Hours: <t t-esc="'%02d:%02d' % (int(last_attendance.extra_hours or 0), int((last_attendance.extra_hours or 0) % 1 * 60))"/></p>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- Mode Information -->
                                                    <div class="mb-3">
                                                        <strong>Mode Information</strong>
                                                        <div class="ms-3">
                                                            <p class="mb-1">Check In Mode: <t t-esc="last_attendance.check_in_mode or 'Manual'"/></p>
                                                            <p class="mb-1">Check Out Mode: <t t-esc="last_attendance.check_out_mode or 'Manual'"/></p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-warning text-center">
                        <h4>Access Restricted</h4>
                        <p>This page is only accessible to employees.</p>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>