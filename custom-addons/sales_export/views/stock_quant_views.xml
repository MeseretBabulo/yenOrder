<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_inherit" model="ir.ui.view">
        <field name="name">stock.quant.tree.inventory.editable</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after" >
                <field name="origin_product" optional="show" width="150"/>
                <field name="grade" optional="show" width="50"/>
                <field name="to_grade" optional="show" width="50"/>
            </xpath>
        </field>
    </record>

     <record id="product_form_view_inherit" model="ir.ui.view">
        <field name="name">product.form.inherit.grade</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="before">
                <field name="grade" invisible="company_id != 2"/>
            </xpath>
        </field>
    </record>
</odoo>
