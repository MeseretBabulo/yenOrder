<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Create Attendance Wizard form view -->
    <data>
        <record id="wizard_create_attendance_form_view" model="ir.ui.view">
            <field name="name">Create Attendance Wizard Form</field>
            <field name="model">wizard.create.attendance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group name='patient_detail'>
                            <span name='address_name'>
                                <field 
                                    name='partner_id' 
                                    required='True' 
                                    invisible='not is_check_in' 
                                    options='{"no_create_edit": true, "no_quick_create": true}'/>
                            </span>
                        </group>

                        <group name='extra_fields'>
                            <group name='group_1'>
                                <field 
                                    name='is_check_in' 
                                    invisible='0'/>
                                <field 
                                    name='check_in_time' 
                                    required='True' 
                                    invisible='not is_check_in'/>
                                <field 
                                    name='check_out_time' 
                                    required='True' 
                                    invisible='is_check_in'/>
                                <field 
                                    name='is_new' 
                                    invisible='not is_check_in'/>
                            </group>
                        </group>

                        <!-- Group for new partner details -->
                        <group invisible='not is_new'>
                            <group name='partner_detail'>
                                <field 
                                    name='partner_firstname' 
                                    required='True'/>
                                <field 
                                    name='partner_lastname' 
                                    required='True'/>
                            </group>

                            <!-- Address fields -->
                            <group name='partner_address'>
                                <div class='o_address_format'>
                                    <field 
                                        name='street' 
                                        placeholder='Street...' 
                                        class='o_address_street' 
                                        required='True'/>
                                    <field 
                                        name='street2' 
                                        placeholder='Street 2...' 
                                        class='o_address_street' 
                                        required='True'/>
                                    <field 
                                        name='city' 
                                        placeholder='City' 
                                        class='o_address_city' 
                                        required='True'/>
                                    <field 
                                        name='state_id' 
                                        class='o_address_state' 
                                        placeholder='State' 
                                        options='{"no_open": true, "no_quick_create": true}' 
                                        context='{"country_id": country_id, "default_country_id": country_id, "zip": zip}' 
                                        required='True'/>
                                    <field 
                                        name='zip' 
                                        placeholder='ZIP' 
                                        class='o_address_zip' 
                                        required='True'/>
                                    <field 
                                        name='country_id' 
                                        placeholder='Country' 
                                        class='o_address_country' 
                                        options='{ "no_open": true, "no_create": true }'
                                        required='True'/>
                                </div>
                            </group>
                        </group>
                    </sheet>

                    <!-- Footer buttons -->
                    <footer>
                        <button string='Confirm' 
                                name='action_create_attendance' 
                                class='oe_highlight' type='object'/>
                        <button string='Cancel' special='cancel' type='object'/>
                    </footer>
                </form>
            </field>
        </record>  
    </data>  
</odoo>
