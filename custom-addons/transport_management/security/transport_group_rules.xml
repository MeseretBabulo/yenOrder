    <!-- Transport Management Category -->
    <record id="module_category_transport_management" model="ir.module.category">
        <field name="name">Transport Management</field>
        <field name="description">Transport Management Settings</field>
        <field name="sequence">40</field>
    </record>

    <!-- Transport Budget Request Group -->
    <record id="group_transport_budget_request" model="res.groups">
