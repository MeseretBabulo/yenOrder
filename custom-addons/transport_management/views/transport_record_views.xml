<odoo>
        <!-- Tree view for Transport Record -->
    <!-- Form view for Transport Record -->
    <record id="view_transport_record_form" model="ir.ui.view">
        <field name="name">transport.record.form</field>
        <field name="model">transport.record</field>
        <field name="arch" type="xml">
            <form string="Transport Record">
                <header>
                    <button string="Submit" type="object" name="action_submit" class="btn-primary" invisible="state != 'draft'"  groups="transport_management.group_transport_budget_request"/>
                    <button string="Approve" type="object" name="action_approve" class="btn-success" invisible="state != 'submitted'"  groups="transport_management.group_transport_budget_approval"/>
                    <button string="Cancel" type="object" name="action_cancel" class="btn-danger" invisible="state != 'submitted'" groups="transport_management.group_transport_budget_request,transport_management.group_transport_budget_approval"/>
                    <button string="Set to Draft" type="object" name="action_set_to_draft" class="btn-info" invisible="state != 'cancelled'" groups="transport_management.group_transport_budget_request,transport_management.group_transport_budget_approval"/>
                    <button 
                        string="Create Transport Bill" 
                        type="object" 
                        name="action_create_transport_bill" 
                        class="btn-primary" 
                        invisible="['|', '|', 
                            ('state', 'not in', ['approved', 'per_diem_billed']), 
                            ('driver_per_diem', '==', 0), 
                            ('total_cost', '==', 0)
                        ]" 
                        groups="transport_management.group_transport_budget_request,transport_management.group_transport_budget_approval"
                    />
                    <button 
                        string="Create Per Diem Bill" 
                        type="object" 
                        name="action_create_per_diem_bill" 
                        class="btn-primary" 
                        invisible="['|', '|', 
                            ('state', 'not in', ['approved', 'transport_billed']), 
                            ('driver_per_diem', '==', 0), 
                            ('total_cost', '==', 0)
                        ]" 
                        groups="transport_management.group_transport_budget_request,transport_management.group_transport_budget_approval"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,cancelled,transport_billed,per_diem_billed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transport_bills" type="object" class="oe_stat_button" icon="fa-truck" modifiers="{'invisible': [['transport_bill_count', '=', 0]]}">
                            <field name="transport_bill_count" widget="statinfo" icon="fa-truck"/>
                        </button>
                        <button name="action_view_per_diem_bills" type="object" class="oe_stat_button" icon="fa-money" modifiers="{'invisible': [['per_diem_bill_count', '=', 0]]}">
                            <field name="per_diem_bill_count" widget="statinfo" icon="fa-money"/>
                        </button>
                    </div>

                    <!-- Basic Information -->
                    <group name="basic_info" string="BASIC INFORMATION">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="transport_provider_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="vehicle_type"/>
                            <field name="plate_number"/>
                        </group>
                    </group>

                    <!-- Journey Details -->
                    <group name="journey_details" string="JOURNEY DETAILS">
                        <group>
                            <field name="source"/>
                            <field name="destination"/>
                            <!-- <field name="transport_cost" string="Transportation Unit Price"/> -->
                        </group>
                        <group>
                            <field name="pick_up_date"/>
                            <field name="delivery_date"/>
                            <!-- <field name="destination_weight" string="Destination Weight (in quintal)"/> -->
                        </group>
                    </group>

                    <!-- Cost Information -->
                    <group name="cost_info" string="COST AND BILLING INFORMATION">
                        <group>
                            <field name="driver_per_diem"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                        <group>
                            <field name="transport_bill_id" readonly="1" widget="many2one"/>
                            <field name="per_diem_bill_id" readonly="1" widget="many2one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_location_combination_form" model="ir.ui.view">
        <field name="name">location.combination.form</field>
        <field name="model">location.combination</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <group>
                        <field name="country" string="Country"/>
                        <field name="state" string="State/City"/>
                    </group>
                      <group>
                        <field name="display_name" string="Display Name" readonly="1"/>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_location_combination_tree" model="ir.ui.view">
        <field name="name">location.combination.tree</field>
        <field name="model">location.combination</field>
        <field name="arch" type="xml">
            <tree>
                <field name="display_name" string="Display Name"/>
                <field name="country" string="Country"/>
            </tree>
        </field>
    </record>

    <!-- Action for Location Combinations -->
    <record id="action_location_combination" model="ir.actions.act_window">
        <field name="name">Location Combinations</field>
        <field name="res_model">location.combination</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure new location combinations here.</p>
        </field>
    </record>

    <!-- Action for Transport Record -->
    <record id="action_transport_record" model="ir.actions.act_window">
        <field name="name">Transport Records</field>
        <field name="res_model">transport.record</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new transport record.
            </p>
        </field>
    </record>

    <!-- Menu Item for Transport Record -->
    <menuitem id="menu_transport_record_root" 
        name="Transport Management" sequence="10" 
        web_icon="transport_management,static/description/icon.png" 
        groups="transport_management.group_transport_budget_request,transport_management.group_transport_budget_approval"/>
    <menuitem id="menu_transport_record" 
        name="Transport Records" 
        parent="menu_transport_record_root" 
        action="action_transport_record" 
        sequence="10" 
        groups="transport_management.group_transport_budget_request,transport_management.group_transport_budget_approval"/>
    <menuitem 
        id="menu_location_combination" 
        name="Location Combinations" 
        parent="menu_transport_record_root" 
        action="action_location_combination" 
        sequence="15" 
        groups="transport_management.group_transport_budget_approval"
    />
</odoo>
