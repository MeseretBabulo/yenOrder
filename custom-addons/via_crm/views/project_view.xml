    <record id="project_task_action_fsm_view_gannt" model="ir.actions.act_window.view">
        <field name="sequence" eval="0" />
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="project_enterprise.project_task_view_gantt" />
        <field name="act_window_id" ref="industry_fsm.project_task_action_fsm" />
    </record> -->
    <data noupdate="1">
        <record id="project_task_action_fsm_view_gannt" model="ir.actions.act_window.view">
            <field name="sequence" eval="0" />
            <field name="view_id" ref="project_enterprise.project_task_view_gantt" />
            <field name="view_mode">gantt</field>
        </record>
    </data>


    <menuitem id="project_task_menu_planning_by_person_support_fsm"
        name="By Person Support"
        sequence="1"
        action="via_crm.project_task_action_fsm_planning_groupby_person_supported"
        parent="industry_fsm.fsm_tasks_menu"
        groups="industry_fsm.group_fsm_user" />

    <record id="industry_fsm.project_task_action_fsm" model="ir.actions.act_window">
        <field name="view_mode">map,gantt,kanban,calendar,tree,form,activity</field>
    </record>

    <record id="industry_fsm.project_task_action_fsm_planning_groupby_user"
        model="ir.actions.act_window">
        <field name="view_mode">gantt,kanban,tree,calendar,map,pivot,graph,form,activity</field>
    </record>


</odoo>
