<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_company_form_inherit_company_type" model="ir.ui.view">
        <field name="name">view.res.company.form.inherit.company.type</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_info']/group/group[1]/field[@name='company_registry']" position="after">
                <field name="via_company_type" required="1"/>
            </xpath>
        </field>
    </record>
</odoo>
