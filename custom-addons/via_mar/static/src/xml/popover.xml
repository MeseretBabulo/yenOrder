<?xml version="1.0" encoding="UTF-8"?>
<template>

    <t t-extend="CalendarView.event.popover">
        <t t-jquery=".o_cw_popover_delete" t-operation="after">
            <a t-if="widget.modelName=='drug.doses.schedule' and !widget._isShowDrugDoseButton()" href="#" class="btn btn-primary o_cw_popover_drug ml-2">Dose Administered</a>
        </t>

        <t t-jquery=".o_cw_popover_edit" t-operation="after">
            <a href="#" class="btn btn-primary o_cw_popover_save_drug ml-2">Save</a>
        </t>

        <t t-jquery=".o_cw_popover_edit" t-operation="replace">
            <a t-if="widget.canEdit and widget.modelName != 'drug.doses.schedule'" href="#" class="btn btn-primary o_cw_popover_edit">Edit</a>
        </t>

    </t>

</template>
