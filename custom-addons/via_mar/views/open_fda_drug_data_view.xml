<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_open_fda_drug_data_form" model="ir.ui.view">
        <field name="name">view.open.fda.drug.data.form</field>
        <field name="model">open.fda.drug.data</field>
        <field name="arch" type="xml">
            <form string="Open FDA Drug Data">
                <sheet>
                    <group name="open_fda_drug_data">
                        <group name="group_1">
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="product_ndc" readonly="1" force_save="1"/>
                        </group>
                        <group name="group_2">
                            <field name="product_type" readonly="1" force_save="1"/>
                            <field name="brand_name" readonly="1" force_save="1"/>
                            <field name="is_imported" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record> 

    <record id="view_open_fda_drug_data_form_form_mar_data_access" model="ir.ui.view">
        <field name="name">view.open.fda.drug.data.form.mar.data.access</field>
        <field name="model">open.fda.drug.data</field>
        <field name="inherit_id" ref="via_mar.view_open_fda_drug_data_form"/>
        <!-- <field name="groups_id" eval="[(4,ref('via_mar.group_mar_drug_data'))]"/> -->
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[@name='group_1']/field[@name='name']" position="attributes">
                <attribute name="readonly">False</attribute>
                <attribute name="required">True</attribute>
            </xpath>
            <xpath expr="//form/sheet/group/group[@name='group_1']/field[@name='product_ndc']" position="attributes">
                <attribute name="readonly">False</attribute>
                <attribute name="required">True</attribute>
            </xpath>
            <xpath expr="//form/sheet/group/group[@name='group_2']/field[@name='product_type']" position="attributes">
                <attribute name="readonly">False</attribute>
                <attribute name="required">True</attribute>
            </xpath>
            <xpath expr="//form/sheet/group/group[@name='group_2']/field[@name='brand_name']" position="attributes">
                <attribute name="readonly">False</attribute>
                <attribute name="required">True</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_open_fda_drug_data_tree" model="ir.ui.view">
        <field name="name">view.open.fda.drug.data.tree</field>
        <field name="model">open.fda.drug.data</field>
        <field name="arch" type="xml">
            <tree string="Open FDA Drug Data">
                <field name="name"/>
                <field name="product_ndc"/>
                <field name="product_type"/>
                <field name="brand_name"/>
                <field name="is_imported" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="open_fda_drug_data_search_view" model="ir.ui.view">
        <field name="name">Open FDA Drug Data Search</field>
        <field name="model">open.fda.drug.data</field>
        <field name="arch" type="xml">
            <search string="Open FDA Drug Data Search">
                <field name="name"/>
                <field name="product_ndc"/>
                <field name="product_type"/>
                <field name="brand_name"/>
                <group expand="1" string="Group By">
                    <filter string="Product Type" name="product_type" domain="[]" context="{'group_by':'product_type'}"/>
                    <filter string="Brand Name" name="brand_name" domain="[]" context="{'group_by':'brand_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_open_fda_drug_data" model="ir.actions.act_window">
        <field name="name">Open FDA Drug Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">open.fda.drug.data</field>
        <field name="view_mode">tree,form,search</field>
        <field name="view_id" ref="view_open_fda_drug_data_tree"/>
    </record>

</odoo>
