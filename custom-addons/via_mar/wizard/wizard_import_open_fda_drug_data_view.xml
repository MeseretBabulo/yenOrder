<?xml version="1.0"?>
<odoo>
    <record id="view_wizard_import_open_fda_drug_data" model="ir.ui.view">
        <field name="name">view.wizard.import.open.fda.drug.data</field>
        <field name="model">wizard.import.open.fda.drug.data</field>
        <field name="arch" type="xml">
            <form string="Import Open FDA Drug Data">
                <group>
                    <field name="disclaimer" readonly="1"/>
                    <field name="terms" readonly="1" widget="html"/>
                    <field name="license" readonly="1" widget="html"/>
                    <field name="last_updated" readonly="1"/>
                </group>
                <group name="main_group">
                    <span>To import drug data please click on Import.</span>
                </group>
                <footer>
                    <button string="Import" name="import_open_fda_drug_data" type="object" class='btn-primary'/> 
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_open_fda_drug_data" model="ir.actions.act_window">
        <field name="name">Import Drug Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.import.open.fda.drug.data</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="via_mar.view_wizard_import_open_fda_drug_data"/>
        <field name="target">new</field>
    </record>

</odoo>