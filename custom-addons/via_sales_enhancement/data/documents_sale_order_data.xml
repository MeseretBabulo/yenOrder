<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Folders -->

        <record id="documents_sale_order_folder" model="documents.folder" forcecreate="1">
            <field name="name">Sale Order</field>
            <field name="group_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="read_group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_specific">True</field>
            <field name="sequence">14</field>
        </record>

        <!-- Facets -->

        <record id="documents_sale_order_documents_facet" model="documents.facet" forcecreate="1">
            <field name="name">Documents</field>
            <field name="sequence">7</field>
            <field name="folder_id" ref="documents_sale_order_folder"/>
        </record>

        <!-- Tags -->


        <record id="documents_sale_order_document_tag" model="documents.tag" forcecreate="1">
            <field name="name">Sale Order Documents</field>
            <field name="facet_id" ref="documents_sale_order_documents_facet"/>
            <field name="sequence">12</field>
        </record>

        <!-- company default setting -->

<!--        <record id="base.main_company" model="res.company">-->
<!--            <field name="documents_sale_order_folder" ref="documents_sale_order_folder"/>-->
<!--        </record>-->

    </data>
</odoo>
