<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_service_note_access">
            <field name="name">Service Note</field>
            <field name="description">Service Note</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_service_note_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="via_sales_enhancement.module_category_service_note_access"/>
        </record>

        <record id="group_service_note_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="implied_ids" eval="[(4, ref('via_sales_enhancement.group_service_note_user'))]"/>
            <field name="category_id" ref="via_sales_enhancement.module_category_service_note_access"/>
        </record>


        <record id="service_note_write_rule" model="ir.rule">
            <field name="name">Service note write groups</field>
            <field name="model_id" ref="model_via_service_note"/>
            <field name="groups" eval="[(4, ref('via_sales_enhancement.group_service_note_user'))]"/>
            <field name="domain_force">[
                ('user_id', '=', user.id)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="service_note_admin_write_rule" model="ir.rule">
            <field name="name">Service note admin write groups</field>
            <field name="model_id" ref="model_via_service_note"/>
            <field name="groups" eval="[(4, ref('via_sales_enhancement.group_service_note_admin'))]"/>
            <field name="domain_force">
                [(1, '=', 1)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
