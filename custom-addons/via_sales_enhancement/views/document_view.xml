<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Documents -->
    <record id="document_view_search_inherit" model="ir.ui.view">
        <field name="name">document.view.search.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_id"/>
            </xpath>
        </field>
    </record>

    <record id="document_view_form_inherit" model="ir.ui.view">
        <field name="name">document.view.form.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_document_kanban_inherit" model="ir.ui.view">
        <field name="name">view.document.kanban.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="sale_id"/>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_record_body')]" position="inside">
                <t t-if="record.sale_id.value"> <br/>
                  <span> <field name="sale_id"/> </span>
                </t>
            </xpath>
        </field>
    </record>

</odoo>
