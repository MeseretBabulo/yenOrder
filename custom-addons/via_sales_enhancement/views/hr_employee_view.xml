<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="hr_employee_inherit_add_smart_button" model="ir.ui.view">
            <field name="name">hr.employee.inherit.add.smart.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[@name='button_box']" position="inside">
                    <button 
                        class="oe_stat_button" 
                        type="action" 
                        name="%(via_sales_enhancement.action_via_service_note)d"
                        context="{'search_default_employee_id': active_id, 'default_employee_id': active_id}"
                        invisible='via_service_note_count == 0' 
                        icon="fa-tasks">
                        <field string="Service Notes" name="via_service_note_count" widget="statinfo"/>
                    </button>
                </xpath>
                <field name="study_school" position="after">
                    <field name="emp_certificate"/>
                    <field name="emp_certificate_name"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
