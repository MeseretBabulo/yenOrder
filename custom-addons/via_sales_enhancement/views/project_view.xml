<odoo>
    <data>
        <record id="project_inherit_add_smart_button" model="ir.ui.view">
            <field name="name">project.inherit.add.smart.button</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[@name='button_box']" position="inside">
                    <button 
                        class="oe_stat_button" 
                        type="action" 
                        name="%(via_sales_enhancement.action_via_service_note)d"
                        context="{'search_default_project_id': id, 'default_project_id': id}"
                        invisible="via_project_service_note_count == 0" 
                        icon="fa-tasks">
                        <field string="Service Notes" name="via_project_service_note_count" widget="statinfo"/>
                    </button>
                </xpath>
                <field name="company_id" position="before">
                    <field name="team_id"/>
                </field>
            </field>
        </record>

        <record id="task_type_edit_inherit_add_fields" model="ir.ui.view">
            <field name="name">task.type.edit.inherit.add.fields</field>
            <field name="model">project.task.type</field>
            <field name="inherit_id" ref="project.task_type_edit"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group/group[2]/field[@name='project_ids']" position="after">
                    <field name="task_color"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
