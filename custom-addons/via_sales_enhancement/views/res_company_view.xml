<odoo>
    <data>
        <record id="view_company_form_inherit_add_fields" model="ir.ui.view">
            <field name="name">view.company.form.inherit.add.fields</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='general_info']/group/group[1]/field[@name='partner_id']" position="after">
                    <field name="default_partner_inv_add_id" options="{'no_create_edit': True, 'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
